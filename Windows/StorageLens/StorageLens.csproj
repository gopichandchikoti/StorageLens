<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\StorageLens.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Authors>Portfolio Engineering</Authors>
    <Product>StorageLens</Product>
    <Description>Local storage inspection and reviewed cleanup</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <EmbeddedResource Include="..\..\public\storagelens.model.json" Link="public\storagelens.model.json" />
    <EmbeddedResource Include="..\..\product.json" Link="product.json" />
  </ItemGroup>
</Project>
